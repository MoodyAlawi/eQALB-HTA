# Server-local environment for the eQalb model API - EXAMPLE.
#
# The real file is /etc/eqalb/api.env. It is server-local, is never committed,
# and is read by systemd through EnvironmentFile= in
# deploy/eqalb-api.service. Create it by copying this file and reviewing each
# value; the whole file can stay as it is, because these are the supported
# production values.
#
#   sudo install -d -m 0755 /etc/eqalb
#   sudo cp /opt/eqalb/deploy/api.env.example /etc/eqalb/api.env
#   sudo chown root:eqalb /etc/eqalb/api.env
#   sudo chmod 0640 /etc/eqalb/api.env
#
# Every variable below is read by the existing code, and none of them is new:
#
#   EQALB_API_HOST, EQALB_API_PORT, EQALB_LOG_LEVEL   api/main.py, api/run_api.py
#   EQALB_R_WORKERS, EQALB_R_TIMEOUT, EQALB_RSCRIPT   api/r_client.py
#
# There is nothing sensitive here. The service has no database, no user
# accounts and no API keys, so this file holds only this host's own choices.
# No domain, IP address, certificate, key or token belongs in it.

# Bind address. Loopback only: Caddy is the only process that listens publicly,
# and nothing on the internet can reach this port directly.
EQALB_API_HOST=127.0.0.1

# Port. 8000 is the production port. Do not use 8788 here: that port belongs to
# the development-only plain plumber service (api/run_api.R), which is not part
# of this deployment.
EQALB_API_PORT=8000

# R worker processes. Keep this at 1: every worker loads the whole R model, the
# VPS has 4 GB of RAM, and a probabilistic sensitivity analysis is expensive.
# api/r_client.py reads this and defaults to 2 when it is unset.
EQALB_R_WORKERS=1

# Seconds to wait for one model response, matching api/api_contract.md.
EQALB_R_TIMEOUT=900

# Full path to Rscript, so the worker does not depend on the PATH systemd
# gives the service. On Ubuntu this is /usr/bin/Rscript.
EQALB_RSCRIPT=/usr/bin/Rscript

# Log level for the API process. INFO in production; DEBUG additionally
# forwards the R worker's own model progress output and is very noisy.
EQALB_LOG_LEVEL=INFO
