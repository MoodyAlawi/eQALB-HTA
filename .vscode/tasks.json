{
  // eQalb launchers.
  // Run with: Terminal > Run Task > pick a task below.
  // "eQalb: run app (127.0.0.1:7788)" is the default build task (Ctrl+Shift+B).
  //
  // To start the Shiny app automatically whenever this folder is opened,
  // uncomment "runOptions" below and allow automatic tasks once when VS Code
  // prompts (or set "task.allowAutomaticTasks": "on" in your user settings).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "eQalb: run app (127.0.0.1:7788)",
      "type": "shell",
      "command": "& 'C:\\Program Files\\R\\R-4.5.1\\bin\\Rscript.exe' '${workspaceFolder}\\run_app.R'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
      // "runOptions": { "runOn": "folderOpen" }
    },
    {
      // FastAPI service (api/main.py) driving the eQalb R model.
      "label": "eQalb: run model API (127.0.0.1:8788)",
      "type": "shell",
      "command": "& '${workspaceFolder}\\api\\.venv\\Scripts\\python.exe' '${workspaceFolder}\\api\\run_api.py'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      // Vue 3 + Vite frontend; proxies /api to the FastAPI service above.
      "label": "eQalb: run frontend dev server (127.0.0.1:5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
